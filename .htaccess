# Nonaktifkan directory listing & MultiViews di luar maupun dalam mod_rewrite
Options -Indexes -MultiViews

# Hardening HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Blokir file sensitif (SQL, script deploy/shell, log, env, dotfiles)
<FilesMatch "(?:^\.|(?i:\.(?:sql|bat|sh|log|ini|bak|old|orig|swp|env|git|md|json|lock)))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    # Matikan MultiViews agar tidak bentrok
    Options -Indexes -MultiViews

    RewriteEngine On
    # RewriteBase dikomentari agar otomatis menyesuaikan folder (lokal /web-app-bapenda/ maupun root domain di server)

    # 0. Blokir akses ke file/direktori tersembunyi (.git, .env, .htaccess, dll) & folder PII pengaduan
    RewriteRule (?:^|/)\. - [F,L]
    RewriteRule ^assets/uploads/pengaduan/ - [F,L,NC]

    # 1. Blokir eksekusi skrip PHP/eksekusi berbahaya di folder assets/uploads & assets/img
    RewriteRule ^assets/.*\.(php|phtml|php[0-9]|phar|pl|py|jsp|asp|sh|cgi)$ - [F,L,NC]

    # 2. Aturan khusus untuk berita
    RewriteRule ^berita/?$ news_list.php [L,QSA]
    RewriteRule ^berita/detail/([0-9]+)/?$ news_detail.php?id=$1 [L,QSA]

    # 2. Abaikan jika yang diakses adalah folder/file fisik (seperti CSS, Gambar, JS)
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Otomatis jalankan file .php meskipun URL-nya tidak diakhiri .php
    # (Ini yang akan menangani URL seperti /page?slug=tugas-dan-fungsi menjadi page.php?slug=tugas-dan-fungsi)
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

