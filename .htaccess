<IfModule mod_rewrite.c>
    # Matikan MultiViews agar tidak bentrok
    Options -Indexes -MultiViews

    RewriteEngine On
    # RewriteBase dikomentari agar otomatis menyesuaikan folder (lokal /web-app-bapenda/ maupun root domain di server)

    # 1. Blokir eksekusi skrip PHP/eksekusi berbahaya di folder assets/uploads & assets/img
    RewriteRule ^assets/.*\.(php|phtml|php[0-9]|phar)$ - [F,L,NC]

    # 2. Aturan khusus untuk berita
    RewriteRule ^berita/?$ news_list.php [L,QSA]
    RewriteRule ^berita/detail/([0-9]+)/?$ news_detail.php?id=$1 [L,QSA]

    # 2. Abaikan jika yang diakses adalah folder/file fisik (seperti CSS, Gambar, JS)
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Otomatis jalankan file .php meskipun URL-nya tidak diakhiri .php
    # (Ini yang akan menangani URL seperti /page?slug=tugas-dan-fungsi menjadi page.php?slug=tugas-dan-fungsi)
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

